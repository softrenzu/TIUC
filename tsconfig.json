{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": [
	"src/**/*.ts",
	"public/**/*.d.ts",
	"worker-configuration.d.ts"
, "public/public/mesh.js.d.ts.ts"]
}